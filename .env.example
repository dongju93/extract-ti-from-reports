# ── Defanging notation ──────────────────────────────────────────────────────
# Characters used in reports to "escape" malicious domains, e.g. example[.]com
# These are stripped when reconstructing the true domain/URL.
DEFANG_OPEN=[
DEFANG_CLOSE=]

# ── ID counters ──────────────────────────────────────────────────────────────
# Starting values for auto-incrementing rule_id and ti_no fields.
START_RULE_ID=10000000
START_TI_NO=1000

# ── TI record metadata defaults ──────────────────────────────────────────────
TI_AREA=endpoint
SITE_TP=internal
REG_USER_ID=admin
